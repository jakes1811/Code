python -c "from dotenv import load_dotenv; import os, psycopg; load_dotenv(); conn=psycopg.connect(host=os.getenv('FINTEL_PG_HOST'), port=os.getenv('FINTEL_PG_PORT'), dbname=os.getenv('FINTEL_PG_DB'), user=os.getenv('FINTEL_PG_USER'), password=os.getenv('FINTEL_PG_PASSWORD')); print('POSTGRESQL CONNECTION: SUCCESS'); cur=conn.cursor(); cur.execute(\"SELECT table_name FROM information_schema.tables WHERE table_schema = 'fintel_gold' AND table_type = 'BASE TABLE' ORDER BY table_name\"); print('GOLD TABLES:'); [print('-', row[0]) for row in cur.fetchall()]; cur.close(); conn.close()"
